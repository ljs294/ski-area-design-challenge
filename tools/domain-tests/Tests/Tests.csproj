<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds and runs Assets/MountainPlanner/Tests/Core (MountainPlanner.Tests.Core.asmdef) under plain .NET. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>MountainPlanner.Tests.Core</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(AssetsRoot)Tests\Core\**\*.cs" />
    <ProjectReference Include="..\Domain\Domain.csproj" />
    <ProjectReference Include="..\Simulation\Simulation.csproj" />
    <ProjectReference Include="..\Persistence\Persistence.csproj" />
    <ProjectReference Include="..\Acquisition\Acquisition.csproj" />
  </ItemGroup>
</Project>
