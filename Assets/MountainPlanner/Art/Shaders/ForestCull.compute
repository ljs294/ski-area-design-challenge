// GPU culling and LOD selection for the forest (0.3 §4.5, TR2): every tree is tested against the camera
// frustum each frame and sorted into its prototype's visible list for one LOD, so the CPU only issues a
// few hundred indirect draws however many trees there are.

#pragma kernel Clear
#pragma kernel Cull
#pragma kernel WriteArgs

struct Tree
{
    float3 position;   // base of the trunk, in world space
    float rotation;    // radians about +Y
    float heightScale;
    float widthScale;
    uint prototype;
    uint pad;
};

StructuredBuffer<Tree> _Trees;
StructuredBuffer<float> _NativeHeights;     // per prototype
StructuredBuffer<float> _Reach;             // per prototype: how far it reaches sideways from its trunk at scale 1 (LOD0 bounds)
StructuredBuffer<uint> _PrototypeStart;     // first slot of each prototype in a LOD band
RWStructuredBuffer<uint> _Visible;          // LOD band l, prototype p: [l * _TreeCount + _PrototypeStart[p] + k]
RWStructuredBuffer<uint> _Counts;           // [p * 4 + l]
RWStructuredBuffer<uint> _Args;             // IndirectDrawIndexedArgs, 5 uints per draw
StructuredBuffer<uint> _DrawCounter;        // per draw: the _Counts slot whose count it draws

uint _TreeCount;
uint _CountSlots;
uint _DrawCount;
float4 _Planes[6];
float3 _CameraPosition;
float _ScreenScale;                         // 1 / (2 tan(fov / 2)): screen-height fraction = size * this / distance
float4 _Transitions;                        // screen heights where LOD0→1, 1→2, 2→card, card→culled
int _ForcedLod;                             // -1: by screen size; 0-3: every visible tree at this LOD (review tools)

[numthreads(64, 1, 1)]
void Clear(uint3 id : SV_DispatchThreadID)
{
    if (id.x < _CountSlots) _Counts[id.x] = 0;
}

[numthreads(64, 1, 1)]
void Cull(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _TreeCount) return;
    Tree t = _Trees[id.x];
    float height = _NativeHeights[t.prototype] * t.heightScale;
    float reach = _Reach[t.prototype] * t.widthScale;
    float3 centre = t.position + float3(0, height * 0.5, 0);
    // A sphere that holds the whole model, even a low krummholz mat trailing metres downwind.
    float radius = max(height * 0.6, sqrt(reach * reach + height * height * 0.25));
    // Its size on screen: its height, or its reach where that's larger (a mat seen from afar).
    float size = max(height, reach);
    [unroll] for (int i = 0; i < 6; i++)
        if (dot(_Planes[i].xyz, centre) + _Planes[i].w < -radius) return;

    float distance = max(length(centre - _CameraPosition), 0.01);
    float screen = size * _ScreenScale / distance;
    uint lod = screen > _Transitions.x ? 0 : screen > _Transitions.y ? 1 : screen > _Transitions.z ? 2 : screen > _Transitions.w ? 3 : 4;
    if (_ForcedLod >= 0) lod = (uint)_ForcedLod;
    if (lod == 4) return;

    uint slot;
    InterlockedAdd(_Counts[t.prototype * 4 + lod], 1, slot);
    _Visible[lod * _TreeCount + _PrototypeStart[t.prototype] + slot] = id.x;
}

[numthreads(64, 1, 1)]
void WriteArgs(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _DrawCount) return;
    _Args[id.x * 5 + 1] = _Counts[_DrawCounter[id.x]];
}

// The crown map (P2-09): how much of each ground texel lies under a tree's crown, 0-1, drawn once when a forest
// opens. The terrain keeps its dark forest floor (and its thinner winter snow) only there, so stands no longer
// sit in brown discs that follow the cover map instead of the trees (MountainTerrain.shader). Coverage adds up
// in fixed point with integer atomics, so the map is the same whatever order the trees are drawn in.
#pragma kernel CrownClear
#pragma kernel CrownSplat
#pragma kernel CrownResolve

StructuredBuffer<float> _CrownRadius;       // per prototype: crown radius at scale 1 (m)
RWStructuredBuffer<uint> _CrownSum;         // per texel: coverage × 256
RWTexture2D<float> _CrownMap;
float4 _CrownRect;                          // west, south, metres per texel, unused
uint2 _CrownSize;                           // texels

[numthreads(64, 1, 1)]
void CrownClear(uint3 id : SV_DispatchThreadID)
{
    if (id.x < _CrownSize.x * _CrownSize.y) _CrownSum[id.x] = 0;
}

void AddCrown(int2 i, float v)
{
    if (v <= 0 || any(i < 0) || any(i >= (int2)_CrownSize)) return;
    InterlockedAdd(_CrownSum[i.y * _CrownSize.x + i.x], (uint)(v * 256 + 0.5));
}

[numthreads(64, 1, 1)]
void CrownSplat(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _TreeCount) return;
    Tree t = _Trees[id.x];
    float r = _CrownRadius[t.prototype] * t.widthScale / _CrownRect.z;        // texels
    float2 p = (t.position.xz - _CrownRect.xy) / _CrownRect.z - 0.5;         // texel-centre coordinates
    int2 i0 = (int2)floor(p);
    if (r < 0.75)
    {
        // Smaller than a texel: its area, shared bilinearly, so a coarse map still sums to the canopy's share.
        float area = 3.14159265 * r * r;
        float2 f = p - i0;
        AddCrown(i0, area * (1 - f.x) * (1 - f.y));
        AddCrown(i0 + int2(1, 0), area * f.x * (1 - f.y));
        AddCrown(i0 + int2(0, 1), area * (1 - f.x) * f.y);
        AddCrown(i0 + int2(1, 1), area * f.x * f.y);
        return;
    }
    // A disc with a one-texel soft edge.
    int reach = (int)ceil(r + 0.5);
    for (int y = -reach; y <= reach; y++)
        for (int x = -reach; x <= reach; x++)
        {
            int2 i = i0 + int2(x, y);
            AddCrown(i, saturate(r - length((float2)i - p) + 0.5));
        }
}

[numthreads(8, 8, 1)]
void CrownResolve(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= _CrownSize)) return;
    _CrownMap[id.xy] = saturate(_CrownSum[id.y * _CrownSize.x + id.x] / 256.0);
}
