<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:mp="MountainPlanner.UI">
    <!-- Task 14: S1 title, S2 My Resorts, S4 download card and pill, S5 quality card, and dialogs (0.4 §4).
         FlowScreens (UI) finds elements by name; AppFlow (App) decides which screen shows.
         Task P2-01: full-screen screens and modals sit in a centred 16:9 column (mp:StageColumn), so they keep
         their shape on 21:9 and 32:9; the download card, pill and toast stay on the screen's edges. -->
    <ui:Style src="Flow.uss" />
    <ui:VisualElement name="flow" class="flow" picking-mode="Ignore">

        <!-- S1 Title: trail signs on cedar posts at the left, centred vertically over the live demo mountain; Credits, Settings and Quit in the corner. -->
        <ui:VisualElement name="title" class="title hidden" picking-mode="Ignore">
            <mp:StageColumn name="title-stage">
            <ui:VisualElement class="signpost">
                <ui:VisualElement class="post post--left" picking-mode="Ignore" />
                <ui:VisualElement class="post post--right" picking-mode="Ignore" />
                <ui:VisualElement class="sign sign--plate sign--name" picking-mode="Ignore">
                    <ui:Label text="SKI AREA DESIGN CHALLENGE" class="sign-name-text" />
                </ui:VisualElement>
                <ui:Button name="title-continue" class="sign sign--green">
                    <ui:VisualElement class="sym sym--circle" picking-mode="Ignore" />
                    <ui:VisualElement class="sign-words" picking-mode="Ignore">
                        <ui:Label name="title-continue-label" text="Continue" class="sign-text" />
                        <ui:Label name="title-continue-sub" text="" class="sign-sub" />
                    </ui:VisualElement>
                    <ui:Label text="›" class="sign-arrow" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="title-new" class="sign sign--blue">
                    <ui:VisualElement class="sym sym--square" picking-mode="Ignore" />
                    <ui:VisualElement class="sign-words" picking-mode="Ignore">
                        <ui:Label text="New Area" class="sign-text" />
                    </ui:VisualElement>
                    <ui:Label text="›" class="sign-arrow" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="title-load" class="sign sign--black">
                    <ui:VisualElement class="sym sym--diamond" picking-mode="Ignore" />
                    <ui:VisualElement class="sign-words" picking-mode="Ignore">
                        <ui:Label text="Load Area" class="sign-text" />
                    </ui:VisualElement>
                    <ui:Label text="›" class="sign-arrow" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="title-manage" class="sign sign--black">
                    <ui:VisualElement class="sym-pair" picking-mode="Ignore">
                        <ui:VisualElement class="sym sym--diamond" />
                        <ui:VisualElement class="sym sym--diamond" />
                    </ui:VisualElement>
                    <ui:VisualElement class="sign-words" picking-mode="Ignore">
                        <ui:Label text="Manage Areas" class="sign-text" />
                    </ui:VisualElement>
                    <ui:Label text="›" class="sign-arrow" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement class="title-corner">
                <ui:Button name="title-credits" text="Credits" class="plate" />
                <ui:Button name="title-settings" text="Settings" class="plate" />
                <ui:Button name="title-quit" text="Quit" class="plate" />
            </ui:VisualElement>
            </mp:StageColumn>
        </ui:VisualElement>

        <!-- S2 My Resorts. -->
        <ui:VisualElement name="library" class="library hidden">
            <mp:StageColumn>
            <ui:VisualElement class="mp-win library-panel">
                <ui:VisualElement class="mp-head">
                    <ui:Label name="library-title" text="Load Area" class="mp-title" />
                    <ui:Label name="library-summary" text="" class="mp-sub" />
                    <ui:VisualElement class="mp-spacer" />
                    <ui:Button name="library-free" text="" class="mp-ghost hidden" tooltip="Remove terrain caches left by older versions of the game" />
                    <ui:Button name="library-new" text="New Area" class="mp-go" />
                    <ui:Button name="library-close" text="✕" class="mp-x" tooltip="Back (Esc)" />
                </ui:VisualElement>
                <ui:VisualElement class="library-sort">
                    <ui:Label text="Sort" class="muted" />
                    <ui:VisualElement class="mp-seg mp-seg--mini">
                        <ui:Button name="sort-opened" text="Last opened" class="mp-seg__opt mp-seg__opt--first" />
                        <ui:Button name="sort-name" text="Name" class="mp-seg__opt" />
                        <ui:Button name="sort-quality" text="Quality" class="mp-seg__opt" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:ScrollView name="library-rows" class="library-rows" mode="Vertical" />
                <ui:Label name="library-empty" text="No areas yet. Choose New Area to download one." class="library-empty hidden" />
                <ui:VisualElement class="panel-foot">
                    <ui:Label name="library-keys" text="" class="muted" />
                    <ui:VisualElement class="spacer" />
                    <ui:Button name="library-folder" text="Open data folder" class="mp-ghost" />
                </ui:VisualElement>
            </ui:VisualElement>
            </mp:StageColumn>
        </ui:VisualElement>

        <!-- S4 download card, docked bottom left. -->
        <ui:VisualElement name="download" class="mp-win download hidden">
            <ui:VisualElement class="mp-head">
                <ui:Label name="dl-title" text="" class="mp-title" />
                <ui:VisualElement class="spacer" />
                <ui:Button name="dl-minimise" text="–" class="mp-x" tooltip="Minimise (Esc)" />
            </ui:VisualElement>
            <ui:VisualElement name="dl-stages" class="dl-stages" />
            <ui:VisualElement class="dl-bar"><ui:VisualElement name="dl-bar-fill" class="dl-bar-fill" /></ui:VisualElement>
            <ui:VisualElement class="dl-row">
                <ui:Label name="dl-percent" text="0%" class="mono strong" />
                <ui:Label name="dl-left" text="" class="mono muted" />
            </ui:VisualElement>
            <ui:Label name="dl-detail" text="" class="dl-detail" />
            <ui:Label name="dl-transfer" text="" class="mono muted" />
            <ui:VisualElement name="dl-actions" class="panel-foot">
                <ui:VisualElement class="spacer" />
                <ui:Button name="dl-cancel" text="Cancel" class="mp-ghost" />
            </ui:VisualElement>
            <ui:VisualElement name="dl-confirm" class="panel-foot hidden">
                <ui:Label text="Stop the download?" class="strong" />
                <ui:VisualElement class="spacer" />
                <ui:Button name="dl-keep" text="Keep for resuming" class="mp-go" />
                <ui:Button name="dl-discard" text="Discard" class="mp-go mp-go--danger" />
                <ui:Button name="dl-back" text="Back" class="mp-ghost" />
            </ui:VisualElement>
            <ui:VisualElement name="dl-failed" class="panel-foot hidden">
                <ui:VisualElement class="spacer" />
                <ui:Button name="dl-retry" text="Retry" class="mp-go" />
                <ui:Button name="dl-close" text="Close" class="mp-ghost" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button name="dl-pill" text="" class="pill hidden" tooltip="Show the download" />

        <!-- S5 quality card. -->
        <ui:VisualElement name="quality" class="modal hidden">
            <mp:StageColumn>
                <ui:VisualElement class="mp-win quality-panel">
                    <ui:VisualElement class="mp-head">
                        <ui:Label name="qc-title" text="" class="mp-title" />
                    </ui:VisualElement>
                    <ui:VisualElement class="panel-body">
                        <ui:Label name="qc-place" text="" class="mono muted" />
                        <ui:VisualElement name="qc-lines" />
                    </ui:VisualElement>
                    <ui:VisualElement class="panel-foot">
                        <ui:Button name="qc-open" text="Open area" class="mp-go" />
                        <ui:Button name="qc-library" text="Load Area" class="mp-ghost" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </mp:StageColumn>
        </ui:VisualElement>

        <!-- S8 Settings: the accepted mockup's window (prototypes/ui-layout.html), with the rows that work so far.
             Categories down the left; each row a label, a line of description and its control. -->
        <ui:VisualElement name="settings" class="modal hidden">
            <mp:StageColumn>
                <ui:VisualElement class="mp-win settings-win">
                    <ui:VisualElement class="mp-head">
                        <ui:Label text="Settings" class="mp-title" />
                        <ui:Label name="settings-resort" text="" class="mp-sub" />
                        <ui:VisualElement class="mp-spacer" />
                        <ui:Button name="settings-close" text="✕" class="mp-x" tooltip="Close (Esc)" />
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-body">
                        <ui:VisualElement class="mp-nav">
                            <ui:Button name="settings-tab-interface" text="Interface" class="mp-nav__item" />
                            <ui:Button name="settings-tab-units" text="Units and time" class="mp-nav__item" />
                            <ui:Button name="settings-tab-graphics" text="Graphics" class="mp-nav__item" />
                        </ui:VisualElement>
                        <ui:ScrollView class="settings-page">
                            <ui:VisualElement name="settings-interface">
                                <ui:Label text="Interface" class="mp-page-title" />
                                <ui:VisualElement class="mp-srow">
                                    <ui:VisualElement class="mp-srow__text">
                                        <ui:Label text="Theme" class="mp-srow__label" />
                                        <ui:Label text="Auto follows the sun: light by day, dark at night." class="mp-srow__desc" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="mp-seg">
                                        <ui:Button name="theme-dark" text="Dark" class="mp-seg__opt mp-seg__opt--first" />
                                        <ui:Button name="theme-light" text="Light" class="mp-seg__opt" />
                                        <ui:Button name="theme-auto" text="Auto" class="mp-seg__opt" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="mp-srow">
                                    <ui:VisualElement class="mp-srow__text">
                                        <ui:Label text="Interface scale" class="mp-srow__label" />
                                        <ui:Label text="The size of the bar, panels and text." class="mp-srow__desc" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="mp-step">
                                        <ui:Button name="scale-down" text="‹" class="mp-step__b" tooltip="Smaller (5% steps, down to 50%)" />
                                        <ui:Label name="scale-value" text="100%" class="mp-step__v" />
                                        <ui:Button name="scale-up" text="›" class="mp-step__b" tooltip="Larger (5% steps, up to 150%)" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="settings-units" class="hidden">
                                <ui:Label text="Units and time" class="mp-page-title" />
                                <ui:VisualElement class="mp-srow">
                                    <ui:VisualElement class="mp-srow__text">
                                        <ui:Label text="Units" class="mp-srow__label" />
                                        <ui:Label text="Lengths, heights, temperatures and snowfall. Steepness is always a grade in percent." class="mp-srow__desc" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="mp-seg">
                                        <ui:Button name="units-metric" text="Metric" class="mp-seg__opt mp-seg__opt--first" />
                                        <ui:Button name="units-imperial" text="Imperial" class="mp-seg__opt" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:Label text="U switches units in the game too." class="mp-note" />
                            </ui:VisualElement>
                            <ui:VisualElement name="settings-graphics" class="hidden">
                                <ui:Label text="Graphics" class="mp-page-title" />
                                <ui:VisualElement class="mp-srow">
                                    <ui:VisualElement class="mp-srow__text">
                                        <ui:Label text="Display mode" class="mp-srow__label" />
                                        <ui:Label text="A window, or the whole screen without a border or with the screen to itself. Alt+Enter switches too." class="mp-srow__desc" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="mp-step">
                                        <ui:Button name="display-prev" text="‹" class="mp-step__b" />
                                        <ui:Label name="display-value" text="Borderless" class="mp-step__v" />
                                        <ui:Button name="display-next" text="›" class="mp-step__b" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:ScrollView>
                    </ui:VisualElement>
                    <ui:VisualElement class="mp-foot">
                        <ui:Button name="settings-defaults" text="Restore defaults" class="mp-ghost" />
                        <ui:Button name="settings-done" text="Done" class="mp-go settings-done" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </mp:StageColumn>
        </ui:VisualElement>
        <ui:VisualElement name="credits" class="modal hidden">
            <mp:StageColumn>
                <ui:VisualElement class="mp-win credits-panel">
                    <ui:VisualElement class="mp-head">
                        <ui:Label text="Credits" class="mp-title" />
                        <ui:VisualElement class="spacer" />
                        <ui:Button name="credits-close" text="✕" class="mp-x" tooltip="Close (Esc)" />
                    </ui:VisualElement>
                    <ui:ScrollView name="credits-body" class="panel-body credits-body" />
                </ui:VisualElement>
            </mp:StageColumn>
        </ui:VisualElement>

        <!-- S11 confirm dialog. -->
        <ui:VisualElement name="confirm" class="modal hidden">
            <mp:StageColumn>
                <ui:VisualElement class="mp-win confirm-panel">
                    <ui:VisualElement class="panel-body">
                        <ui:Label name="confirm-text" text="" class="confirm-text" />
                    </ui:VisualElement>
                    <ui:VisualElement class="panel-foot">
                        <ui:VisualElement class="spacer" />
                        <ui:Button name="confirm-cancel" text="Cancel" class="mp-ghost" />
                        <ui:Button name="confirm-ok" text="Delete" class="mp-go mp-go--danger" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </mp:StageColumn>
        </ui:VisualElement>

        <!-- A one-line text dialog (task P2-04): the mockup's Rename, reusable through FlowScreens.Prompt. -->
        <ui:VisualElement name="prompt" class="modal hidden">
            <mp:StageColumn>
                <ui:VisualElement class="mp-win prompt-panel">
                    <ui:VisualElement class="mp-head">
                        <ui:Label name="prompt-title" text="Rename area" class="mp-title" />
                        <ui:VisualElement class="mp-spacer" />
                        <ui:Button name="prompt-close" text="✕" class="mp-x" tooltip="Cancel (Esc)" />
                    </ui:VisualElement>
                    <ui:TextField name="prompt-field" class="prompt-field" max-length="60" />
                    <ui:Label name="prompt-hint" text="" class="prompt-hint" />
                    <ui:VisualElement class="prompt-acts">
                        <ui:Button name="prompt-ok" text="Rename" class="mp-go prompt-go" />
                        <ui:Button name="prompt-cancel" text="Cancel" class="mp-ghost" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </mp:StageColumn>
        </ui:VisualElement>

        <ui:Label name="toast" text="" class="toast hidden" />
    </ui:VisualElement>
</ui:UXML>
