<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:mp="MountainPlanner.UI">
    <!-- Task 14: S1 title, S2 My Resorts, S4 download card and pill, S5 quality card, and dialogs (0.4 §4).
         FlowScreens (UI) finds elements by name; AppFlow (App) decides which screen shows.
         Task P2-01: full-screen screens and modals sit in a centred 16:9 column (mp:StageColumn), so they keep
         their shape on 21:9 and 32:9; the download card, pill and toast stay on the screen's edges. -->
    <ui:Style src="Flow.uss" />
    <ui:Style src="FlowReport.uss" />
    <ui:VisualElement name="flow" class="flow" picking-mode="Ignore">

        <!-- S1 Title: trail signs on cedar posts at the left, centred vertically over the live demo mountain; Credits, Settings and Quit in the corner. -->
        <ui:VisualElement name="title" class="title hidden" picking-mode="Ignore">
            <mp:StageColumn name="title-stage">
            <ui:VisualElement class="signpost">
                <ui:VisualElement class="post post--left" picking-mode="Ignore" />
                <ui:VisualElement class="post post--right" picking-mode="Ignore" />
                <!-- The name plate (task P2-03.1): the game's logo and name (tools/brand/export.py). -->
                <ui:VisualElement class="sign sign--plate sign--name" picking-mode="Ignore">
                    <ui:VisualElement name="title-logo" class="brand title-logo" picking-mode="Ignore" tooltip="Ski Area Design Challenge" />
                </ui:VisualElement>
                <ui:Button name="title-continue" class="sign sign--green">
                    <ui:VisualElement class="sym sym--circle" picking-mode="Ignore" />
                    <ui:VisualElement class="sign-words" picking-mode="Ignore">
                        <ui:Label name="title-continue-label" text="Continue" class="sign-text" />
                        <ui:Label name="title-continue-sub" text="" class="sign-sub" />
                    </ui:VisualElement>
                    <ui:Label text="›" class="sign-arrow" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="title-new" class="sign sign--blue">
                    <ui:VisualElement class="sym sym--square" picking-mode="Ignore" />
                    <ui:VisualElement class="sign-words" picking-mode="Ignore">
                        <ui:Label text="New Area" class="sign-text" />
                    </ui:VisualElement>
                    <ui:Label text="›" class="sign-arrow" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="title-load" class="sign sign--black">
                    <ui:VisualElement class="sym sym--diamond" picking-mode="Ignore" />
                    <ui:VisualElement class="sign-words" picking-mode="Ignore">
                        <ui:Label text="Load Area" class="sign-text" />
                    </ui:VisualElement>
                    <ui:Label text="›" class="sign-arrow" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="title-manage" class="sign sign--black">
                    <ui:VisualElement class="sym-pair" picking-mode="Ignore">
                        <ui:VisualElement class="sym sym--diamond" />
                        <ui:VisualElement class="sym sym--diamond" />
                    </ui:VisualElement>
                    <ui:VisualElement class="sign-words" picking-mode="Ignore">
                        <ui:Label text="Manage Areas" class="sign-text" />
                    </ui:VisualElement>
                    <ui:Label text="›" class="sign-arrow" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
            <!-- Task P2-10: the game's version, bottom left (owner, 2026-10-12); the same text heads the error log. -->
            <ui:Label name="title-version" text="" class="title-version" picking-mode="Ignore" />
            <ui:VisualElement class="title-corner">
                <ui:Button name="title-credits" text="Credits" class="plate" />
                <ui:Button name="title-settings" text="Settings" class="plate" />
                <ui:Button name="title-quit" text="Quit" class="plate" />
                <!-- Alpine Labs as one more plate in the corner (owner, 2026-10-11): it signs the game and does nothing. -->
                <ui:VisualElement name="title-alpine-labs" class="plate plate--brand" tooltip="Alpine Labs">
                    <ui:VisualElement class="brand plate-brand-logo" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            </mp:StageColumn>
        </ui:VisualElement>

        <!-- S2 My Resorts. -->
        <ui:VisualElement name="library" class="library hidden">
            <mp:StageColumn>
            <ui:VisualElement class="mp-win library-panel">
                <ui:VisualElement class="mp-head">
                    <ui:Label name="library-title" text="Load Area" class="mp-title" />
                    <ui:Label name="library-summary" text="" class="mp-sub" />
                    <ui:VisualElement class="mp-spacer" />
                    <ui:Button name="library-free" text="" class="mp-ghost hidden" tooltip="Remove terrain caches left by older versions of the game" />
                    <ui:Button name="library-new" text="New Area" class="mp-go" />
                    <ui:Button name="library-close" text="✕" class="mp-x" tooltip="Back (Esc)" />
                </ui:VisualElement>
                <ui:VisualElement class="library-sort">
                    <ui:Label text="Sort" class="muted" />
                    <ui:VisualElement class="mp-seg mp-seg--mini">
                        <ui:Button name="sort-opened" text="Last opened" class="mp-seg__opt mp-seg__opt--first" />
                        <ui:Button name="sort-name" text="Name" class="mp-seg__opt" />
                        <ui:Button name="sort-quality" text="Quality" class="mp-seg__opt" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:ScrollView name="library-rows" class="library-rows" mode="Vertical" />
                <ui:Label name="library-empty" text="No areas yet. Choose New Area to download one." class="library-empty hidden" />
                <ui:VisualElement class="panel-foot">
                    <ui:Label name="library-keys" text="" class="muted" />
                    <ui:VisualElement class="spacer" />
                    <ui:Button name="library-folder" text="Open data folder" class="mp-ghost" />
                </ui:VisualElement>
            </ui:VisualElement>
            </mp:StageColumn>
        </ui:VisualElement>

        <!-- Task P2-03.1: the loading screen over every load (launch, Open, Exit to title). The title's own picture fills the
             screen, so the mountain is never seen filling in; one box at the HUD panels' opacity holds the game's logo,
             "Opening ...", the bar, a Details list (click only, remembered) and the studio. The box and picture fade over the
             finished mountain. Above the title and library, and it takes the pointer, so nothing underneath can be used; the
             download card and pill, the dialogs and the toast (task P2-06) come after it, so they stay usable while an area
             opens. -->
        <ui:VisualElement name="cover" class="cover hidden">
            <ui:VisualElement name="cover-still" class="cover-still" picking-mode="Ignore" />
            <ui:VisualElement name="cover-box" class="cover-box">
                <ui:VisualElement name="cover-plate" class="cover-plate" picking-mode="Ignore" />
                <ui:VisualElement name="cover-game" class="cover-game" picking-mode="Ignore">
                    <ui:VisualElement name="cover-logo" class="brand cover-logo" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="cover-text" text="" class="cover-text" picking-mode="Ignore" />
                <ui:VisualElement class="cover-bar" picking-mode="Ignore">
                    <ui:VisualElement name="cover-fill" class="cover-fill" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="cover-line" picking-mode="Ignore">
                    <ui:Label name="cover-percent" text="0%" class="cover-percent mono" picking-mode="Ignore" />
                    <ui:Label name="cover-elapsed" text="" class="cover-elapsed mono hidden" picking-mode="Ignore" />
                    <ui:Button name="cover-details-toggle" text="Show details" class="cover-toggle" />
                </ui:VisualElement>
                <ui:VisualElement name="cover-details" class="cover-details hidden" picking-mode="Ignore">
                    <ui:VisualElement name="ld-package" class="ld-row" picking-mode="Ignore">
                        <ui:Label text="" class="ld-tick" picking-mode="Ignore" />
                        <ui:Label text="Reading the area" class="ld-name" picking-mode="Ignore" />
                        <ui:Label text="" class="ld-count mono" picking-mode="Ignore" />
                        <ui:Label text="" class="ld-time mono" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="ld-preparing" class="ld-row" picking-mode="Ignore">
                        <ui:Label text="" class="ld-tick" picking-mode="Ignore" />
                        <ui:Label text="Preparing terrain (first open only)" class="ld-name" picking-mode="Ignore" />
                        <ui:Label text="" class="ld-count mono" picking-mode="Ignore" />
                        <ui:Label text="" class="ld-time mono" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="ld-terrain" class="ld-row" picking-mode="Ignore">
                        <ui:Label text="" class="ld-tick" picking-mode="Ignore" />
                        <ui:Label text="Terrain" class="ld-name" picking-mode="Ignore" />
                        <ui:Label text="" class="ld-count mono" picking-mode="Ignore" />
                        <ui:Label text="" class="ld-time mono" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="ld-groundcover" class="ld-row" picking-mode="Ignore">
                        <ui:Label text="" class="ld-tick" picking-mode="Ignore" />
                        <ui:Label text="Ground cover" class="ld-name" picking-mode="Ignore" />
                        <ui:Label text="" class="ld-count mono" picking-mode="Ignore" />
                        <ui:Label text="" class="ld-time mono" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="ld-snowpack" class="ld-row" picking-mode="Ignore">
                        <ui:Label text="" class="ld-tick" picking-mode="Ignore" />
                        <ui:Label text="Snowpack" class="ld-name" picking-mode="Ignore" />
                        <ui:Label text="" class="ld-count mono" picking-mode="Ignore" />
                        <ui:Label text="" class="ld-time mono" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="ld-cliffs" class="ld-row" picking-mode="Ignore">
                        <ui:Label text="" class="ld-tick" picking-mode="Ignore" />
                        <ui:Label text="Cliffs" class="ld-name" picking-mode="Ignore" />
                        <ui:Label text="" class="ld-count mono" picking-mode="Ignore" />
                        <ui:Label text="" class="ld-time mono" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="ld-forest" class="ld-row" picking-mode="Ignore">
                        <ui:Label text="" class="ld-tick" picking-mode="Ignore" />
                        <ui:Label text="Forest" class="ld-name" picking-mode="Ignore" />
                        <ui:Label text="" class="ld-count mono" picking-mode="Ignore" />
                        <ui:Label text="" class="ld-time mono" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="cover-studio" class="cover-studio" picking-mode="Ignore">
                    <ui:VisualElement name="cover-studio-logo" class="brand cover-studio-logo" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- S4 download card, docked bottom left. -->
        <ui:VisualElement name="download" class="mp-win download hidden">
            <ui:VisualElement class="mp-head">
                <ui:Label name="dl-title" text="" class="mp-title" />
                <ui:VisualElement class="spacer" />
                <ui:Button name="dl-minimise" text="–" class="mp-x" tooltip="Minimise (Esc)" />
            </ui:VisualElement>
            <ui:VisualElement name="dl-stages" class="dl-stages" />
            <ui:VisualElement class="dl-bar"><ui:VisualElement name="dl-bar-fill" class="dl-bar-fill" /></ui:VisualElement>
            <ui:VisualElement class="dl-row">
                <ui:Label name="dl-percent" text="0%" class="mono strong" />
                <ui:Label name="dl-left" text="" class="mono muted" />
            </ui:VisualElement>
            <ui:Label name="dl-detail" text="" class="dl-detail" />
            <ui:Label name="dl-transfer" text="" class="mono muted" />
            <ui:VisualElement name="dl-actions" class="panel-foot">
                <ui:VisualElement class="spacer" />
                <ui:Button name="dl-cancel" text="Cancel" class="mp-ghost" />
            </ui:VisualElement>
            <ui:VisualElement name="dl-confirm" class="panel-foot hidden">
                <ui:Label text="Stop the download?" class="strong" />
                <ui:VisualElement class="spacer" />
                <ui:Button name="dl-keep" text="Keep for resuming" class="mp-go" />
                <ui:Button name="dl-discard" text="Discard" class="mp-go mp-go--danger" />
                <ui:Button name="dl-back" text="Back" class="mp-ghost" />
            </ui:VisualElement>
            <ui:VisualElement name="dl-waiting" class="panel-foot hidden">
                <ui:VisualElement class="spacer" />
                <ui:Button name="dl-trynow" text="Try now" class="mp-go" />
                <ui:Button name="dl-wait-cancel" text="Cancel" class="mp-ghost" />
            </ui:VisualElement>
            <ui:VisualElement name="dl-failed" class="panel-foot hidden">
                <ui:VisualElement class="spacer" />
                <ui:Button name="dl-retry" text="Retry" class="mp-go" />
                <ui:Button name="dl-close" text="Close" class="mp-ghost" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- The S4 pill (task P2-06): one line and a hairline of progress; S1, S2 and the picker (the game's is in the HUD bar). -->
        <ui:Button name="dl-pill" text="" class="pill hidden" tooltip="Show the download">
            <ui:Label name="dl-pill-text" text="" class="pill-text" />
            <ui:VisualElement class="pill-bar"><ui:VisualElement name="dl-pill-fill" class="pill-fill" /></ui:VisualElement>
        </ui:Button>

        <!-- S5 quality card. -->
        <ui:VisualElement name="quality" class="modal hidden">
            <mp:StageColumn>
                <ui:VisualElement class="mp-win quality-panel">
                    <ui:VisualElement class="mp-head">
                        <ui:Label name="qc-title" text="" class="mp-title" />
                    </ui:VisualElement>
                    <ui:VisualElement class="panel-body">
                        <ui:Label name="qc-place" text="" class="mono muted" />
                        <ui:VisualElement name="qc-lines" />
                    </ui:VisualElement>
                    <ui:VisualElement class="panel-foot">
                        <ui:Button name="qc-open" text="Open area" class="mp-go" />
                        <ui:Button name="qc-library" text="Load Area" class="mp-ghost" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </mp:StageColumn>
        </ui:VisualElement>

        <!-- S8 Settings: the accepted mockup's window (prototypes/ui-layout.html). Categories down the left; each row a
             label, a line of description and its control. -->
        <ui:VisualElement name="settings" class="modal hidden">
            <mp:StageColumn>
                <ui:VisualElement class="mp-win settings-win">
                    <ui:VisualElement class="mp-head">
                        <ui:Label text="Settings" class="mp-title" />
                        <ui:Label name="settings-resort" text="" class="mp-sub" />
                        <ui:VisualElement class="mp-spacer" />
                        <ui:Button name="settings-close" text="✕" class="mp-x" tooltip="Close (Esc)" />
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-body">
                        <!-- The categories and their rows are built by SettingsWindow (task P2-05), as the mockup builds them from its SETTINGS table. -->
                        <ui:VisualElement name="settings-nav" class="mp-nav" />
                        <ui:ScrollView name="settings-page" class="settings-page" />
                    </ui:VisualElement>
                    <ui:VisualElement class="mp-foot">
                        <ui:Button name="settings-defaults" text="Restore defaults" class="mp-ghost" />
                        <ui:Button name="settings-done" text="Done" class="mp-go settings-done" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </mp:StageColumn>
        </ui:VisualElement>
        <!-- S9 Credits (task P2-07; mockup #demo=credits): the game and the studio, each area's data sources with their
             licence on the right, the picker's map and search, textures, software and type; Licence texts swaps the page. -->
        <ui:VisualElement name="credits" class="modal hidden">
            <mp:StageColumn>
                <ui:VisualElement name="credits-panel" class="mp-win credits-panel">
                    <ui:VisualElement class="mp-head">
                        <ui:Label name="credits-title" text="Credits" class="mp-title" />
                        <ui:Label name="credits-subtitle" text="" class="mp-sub hidden" />
                        <ui:VisualElement class="spacer" />
                        <ui:Button name="credits-x" text="✕" class="mp-x" tooltip="Close (Esc)" />
                    </ui:VisualElement>
                    <ui:ScrollView name="credits-body" class="credits-body" />
                    <ui:VisualElement class="mp-foot credits-foot">
                        <ui:Label name="credits-offline" text="" class="credits-note" />
                        <ui:Button name="credits-licences" text="Licence texts" class="mp-ghost credits-licences" />
                        <ui:Button name="credits-close" text="Close" class="mp-go credits-done" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </mp:StageColumn>
        </ui:VisualElement>

        <!-- S11 dialogs (task P2-06): confirm (no title), error and offline (a title, then what to do). -->
        <ui:VisualElement name="confirm" class="modal hidden">
            <mp:StageColumn>
                <ui:VisualElement name="confirm-panel" class="mp-win confirm-panel">
                    <ui:VisualElement class="panel-body">
                        <ui:Label name="confirm-title" text="" class="confirm-title hidden" />
                        <ui:Label name="confirm-text" text="" class="confirm-text" />
                    </ui:VisualElement>
                    <ui:VisualElement class="panel-foot">
                        <ui:Button name="confirm-alt" text="" class="mp-ghost hidden" />
                        <ui:VisualElement class="spacer" />
                        <ui:Button name="confirm-cancel" text="Cancel" class="mp-ghost" />
                        <ui:Button name="confirm-ok" text="Delete" class="mp-go mp-go--danger" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </mp:StageColumn>
        </ui:VisualElement>

        <!-- A one-line text dialog (task P2-04): the mockup's Rename, reusable through FlowScreens.Prompt. -->
        <ui:VisualElement name="prompt" class="modal hidden">
            <mp:StageColumn>
                <ui:VisualElement class="mp-win prompt-panel">
                    <ui:VisualElement class="mp-head">
                        <ui:Label name="prompt-title" text="Rename area" class="mp-title" />
                        <ui:VisualElement class="mp-spacer" />
                        <ui:Button name="prompt-close" text="✕" class="mp-x" tooltip="Cancel (Esc)" />
                    </ui:VisualElement>
                    <ui:TextField name="prompt-field" class="prompt-field" max-length="60" />
                    <ui:Label name="prompt-hint" text="" class="prompt-hint" />
                    <ui:VisualElement class="prompt-acts">
                        <ui:Button name="prompt-ok" text="Rename" class="mp-go prompt-go" />
                        <ui:Button name="prompt-cancel" text="Cancel" class="mp-ghost" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </mp:StageColumn>
        </ui:VisualElement>

        <ui:Label name="toast" text="" class="toast hidden" />

        <!-- Task P2-10: the session's first error (once per session, owner 2026-10-12): a log was saved; open its folder.
             Brought to the front when shown, so it shows over the cover too. -->
        <ui:VisualElement name="error-notice" class="error-notice hidden">
            <ui:Label name="error-notice-text" text="Something went wrong. A log was saved for a bug report." class="error-notice-text" />
            <ui:Button name="error-notice-send" text="Send logs" class="mp-go" />
            <ui:Button name="error-notice-open" text="Open folder" class="mp-ghost" />
            <ui:Button name="error-notice-x" text="✕" class="mp-x" tooltip="Close" />
        </ui:VisualElement>

        <!-- Task P3-14: the title's offer after the game closed unexpectedly (#demo=crashoffer), once per crash. -->
        <ui:VisualElement name="crash-notice" class="error-notice hidden">
            <ui:Label name="crash-notice-text" text="The game closed unexpectedly last time. Send a report?" class="error-notice-text" />
            <ui:Button name="crash-notice-send" text="Send report" class="mp-go" />
            <ui:Button name="crash-notice-later" text="Not now" class="mp-ghost" />
        </ui:VisualElement>

        <!-- Task P3-14: Send feedback (#demo=fb, fbsug, fbcrash) and Report saved (#demo=fbsent). FlowScreens.Report.cs fills the parts. -->
        <ui:VisualElement name="feedback" class="modal hidden">
            <mp:StageColumn>
                <ui:VisualElement name="feedback-panel" class="mp-win feedback-panel">
                    <ui:VisualElement class="mp-head">
                        <ui:Label name="feedback-head" text="Send feedback" class="mp-title" />
                        <ui:VisualElement class="mp-spacer" />
                        <ui:Button name="feedback-x" text="✕" class="mp-x" tooltip="Cancel (Esc)" />
                    </ui:VisualElement>
                    <ui:VisualElement name="feedback-form" class="feedback-form">
                        <!-- The form scrolls when the window is taller than the screen (150% on 1080p); the buttons stay. -->
                        <ui:ScrollView name="feedback-body" class="feedback-body" horizontal-scroller-visibility="Hidden">
                            <ui:VisualElement name="feedback-kind" class="mp-seg feedback-kind">
                                <ui:Button name="feedback-kind-problem" text="Problem" class="mp-seg__opt mp-seg__opt--first" />
                                <ui:Button name="feedback-kind-suggestion" text="Suggestion" class="mp-seg__opt" />
                            </ui:VisualElement>
                            <ui:Label name="feedback-summary-cap" text="In a few words" class="feedback-cap" />
                            <ui:TextField name="feedback-summary" class="feedback-field" max-length="80" />
                            <ui:Label name="feedback-note-cap" text="What happened, and what were you doing?" class="feedback-cap" />
                            <ui:TextField name="feedback-note" class="feedback-field feedback-note" multiline="true" max-length="4000" />
                            <ui:Label text="Included in the report" class="feedback-cap" />
                            <ui:VisualElement name="feedback-parts" class="feedback-parts" />
                            <ui:VisualElement name="feedback-total" class="feedback-total">
                                <ui:Label name="feedback-total-text" text="Saved as one zip file on this PC" class="feedback-total__l" />
                                <ui:Label name="feedback-size" text="" class="feedback-total__r mono" />
                            </ui:VisualElement>
                            <ui:Label name="feedback-privacy" text="Nothing is sent until you post it yourself. Your Windows user name is taken out of the logs. &lt;b&gt;GitHub issues are public.&lt;/b&gt;" class="feedback-privacy" />
                        </ui:ScrollView>
                        <ui:VisualElement class="feedback-acts">
                            <ui:Button name="feedback-send" text="Save and open GitHub" class="mp-go feedback-go" />
                            <ui:Button name="feedback-save" text="Save only" class="mp-ghost" />
                            <ui:Button name="feedback-cancel" text="Cancel" class="mp-ghost" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="feedback-done" class="feedback-form hidden">
                        <ui:VisualElement class="feedback-file">
                            <ui:Label name="feedback-file" text="" class="feedback-file__name mono" />
                            <ui:Label name="feedback-file-size" text="" class="feedback-file__size mono" />
                        </ui:VisualElement>
                        <ui:Label name="feedback-step1" text="" class="feedback-step" />
                        <ui:Label name="feedback-step2" text="" class="feedback-step" />
                        <ui:Label name="feedback-hint" text="No GitHub account? Send the file to the developer any way you like." class="feedback-hint" />
                        <ui:VisualElement class="feedback-acts">
                            <ui:Button name="feedback-done-ok" text="Done" class="mp-go feedback-go" />
                            <ui:Button name="feedback-folder" text="Show in folder" class="mp-ghost" />
                            <ui:Button name="feedback-copy" text="Copy summary" class="mp-ghost" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </mp:StageColumn>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
