/* Task 14 screens in the Trailhead direction (game-ui-direction.md UI-6): solid panels with hairline rules;
   trail-rated signs on cedar posts for the title. The colours are the shared theme tokens (dark or light,
   Resources/MountainPlannerUI/Theme-*.tss) and so are the fonts (Base.uss); only the signs keep their own
   colours, which don't change with the theme (task P2-01).
   Ultrawide: the title, the library and the modals sit in a centred 16:9 column (StageColumn); the download
   card, its pill and toasts stay on the screen's edges. */

.flow {
    --sign-green: #1a6b3c;
    --sign-blue: #22558f;
    --sign-black: #1f1c19;
    --sign-face-text: #fbf8f2;
    --cedar: #93643e;
    --cedar-dark: #5a3a22;

    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    color: var(--text);
    -unity-text-outline-color: var(--text);
    font-size: 14px;
}

.hidden { display: none; }
.spacer { flex-grow: 1; }
.muted { color: var(--soft); -unity-text-outline-color: var(--soft); }
.strong { color: var(--strong); -unity-text-outline-color: var(--strong); -unity-font-style: bold; }
.error { color: var(--neg); -unity-text-outline-color: var(--neg); }

/* ---------- S1 title: the signpost, at the left and centred vertically ---------- */
.title { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.title > .ui-stage { overflow: hidden; }
.signpost {
    position: absolute; left: 96px; top: 50%; width: 340px;
    translate: 0 -50%;
}
/* Posts run from behind the name plate down past the bottom of the screen. */
.post {
    position: absolute; top: 18px; bottom: -2000px; width: 18px;
    background-color: var(--cedar);
    border-left-width: 4px; border-right-width: 4px;
    border-left-color: var(--cedar-dark); border-right-color: #7e5434;
}
.post--left { left: 44px; }
.post--right { left: 270px; }

.sign {
    flex-direction: row; align-items: center;
    margin: 0 0 18px 0; padding: 12px 16px 12px 22px;
    min-height: 58px;
    border-width: 1px; border-color: var(--sign-face-text); border-radius: 2px;
    color: var(--sign-face-text);
    -unity-text-outline-color: var(--sign-face-text);
    font-size: 19px; -unity-font-style: bold;
    -unity-text-align: middle-left;
    transition-property: translate; transition-duration: 0.12s;
}
.sign:hover, .sign:focus { translate: 4px 0; }
.sign--green { background-color: var(--sign-green); }
.sign--blue { background-color: var(--sign-blue); }
.sign--black { background-color: var(--sign-black); }
#title-manage { margin-bottom: 0; }
/* The name plate: plain sign white with dark letters, like the brand board plates. */
.sign--plate { background-color: #fbf8f2; border-width: 2px; border-color: #1f1c19; }
.sign--name { margin-bottom: 26px; min-height: 0; padding: 12px 14px; justify-content: center; }
.sign-name-text { font-size: 16px; letter-spacing: 1px; -unity-font-style: bold; color: #1f1c19; -unity-text-outline-color: #1f1c19; -unity-text-align: middle-center; }
.sign-words { flex-grow: 1; margin-left: 14px; }
.sign-text { font-size: 19px; -unity-font-style: bold; color: var(--sign-face-text); -unity-text-outline-color: var(--sign-face-text); padding: 0; margin: 0; }
.sign-sub { font-size: 12px; -unity-font-style: normal; color: var(--sign-face-text); -unity-text-outline-color: var(--sign-face-text); opacity: 0.85; padding: 0; margin: 2px 0 0 0; }
.sign-arrow { font-size: 24px; color: var(--sign-face-text); -unity-text-outline-color: var(--sign-face-text); -unity-font-style: bold; }

/* Trail-rating symbols: white on the sign face; double black is two diamonds. */
.sym { width: 18px; height: 18px; background-color: var(--sign-face-text); flex-shrink: 0; }
.sym--circle { border-radius: 9px; }
.sym--square { width: 16px; height: 16px; }
.sym--diamond { width: 14px; height: 14px; rotate: 45deg; margin: 2px; }
.sym-pair { flex-direction: row; }
.sym-pair .sym--diamond { margin: 2px 4px 2px 2px; }

/* Credits, Settings, Quit: small white plates in the bottom-right corner. */
.title-corner { position: absolute; right: 24px; bottom: 24px; flex-direction: row; }
.plate {
    margin: 0 0 0 10px; padding: 6px 16px;
    background-color: #fbf8f2; color: #1f1c19;
    -unity-text-outline-color: #1f1c19;
    border-width: 2px; border-color: #1f1c19; border-radius: 2px;
    font-size: 14px; -unity-font-style: bold;
}
.plate:hover { background-color: #ffffff; }

/* ---------- Panels: the mockup's window, head, buttons and switches (Base.uss, mp-*) ---------- */
.panel-body { padding: 12px 16px; }
.panel-foot {
    flex-direction: row; align-items: center;
    padding: 10px 12px;
    border-top-width: 1px; border-top-color: var(--hair);
}
.panel-foot > .mp-go, .panel-foot > .mp-ghost, .lib-actions > .mp-go, .lib-actions > .mp-ghost { margin-left: 8px; }
.mp-head > .mp-go, .mp-head > .mp-ghost { height: 28px; margin-right: 6px; }

.modal {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-color: var(--scrim-strong);
}
.modal > .ui-stage { align-items: center; justify-content: center; }
/* A modal never leaves the screen: at 150% on a 4:3 screen the column is 640 units wide. */
.modal > .ui-stage > .mp-win { max-width: 96%; max-height: 96%; flex-shrink: 1; }

/* ---------- S2 My Resorts ---------- */
.library {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-color: var(--scrim-strong);
}
.library > .ui-stage { padding: 32px 48px; }   /* on the mockup's 1280×720 stage */
.library-panel { flex-grow: 0; flex-shrink: 1; max-height: 100%; }
.library-sort { flex-direction: row; align-items: center; padding: 8px 16px; border-bottom-width: 1px; border-bottom-color: var(--hair); }
.library-sort > .muted { margin-right: 8px; font-size: 12px; }
.library-rows { flex-grow: 0; flex-shrink: 1; min-height: 48px; }
.library-empty { white-space: normal; padding: 32px 16px; color: var(--muted); -unity-text-outline-color: var(--muted); font-size: 15px; }

.lib-row {
    flex-direction: row; align-items: center; flex-wrap: wrap;   /* at large UI scales the cells and buttons wrap, never scroll sideways */
    min-height: 48px; padding: 4px 16px;
    border-bottom-width: 1px; border-bottom-color: var(--row);
}
.lib-row:hover { background-color: var(--hover); }
.lib-row--selected { background-color: var(--chip); }
.lib-name { width: 220px; overflow: hidden; text-overflow: ellipsis; font-size: 15px; -unity-font-style: bold; color: var(--strong); -unity-text-outline-color: var(--strong); }
.lib-cell { width: 150px; color: var(--muted); -unity-text-outline-color: var(--muted); font-size: 13px; }
.lib-cell--narrow { width: 80px; }
.lib-score { width: 150px; font-size: 13px; }
.lib-score--excellent, .lib-score--good { color: var(--pos); -unity-text-outline-color: var(--pos); }
.lib-score--fair { color: var(--warn); -unity-text-outline-color: var(--warn); }
.lib-score--limited { color: var(--neg); -unity-text-outline-color: var(--neg); }
.lib-paused { flex-grow: 1; color: var(--warn); -unity-text-outline-color: var(--warn); font-size: 13px; }
.lib-actions { flex-direction: row; flex-shrink: 0; margin-left: auto; padding: 2px 0; }
/* Manage Areas' rows carry Rename and Delete (task P2-04): a narrower last-opened column keeps them on one line at
   100%; a long name ends in an ellipsis (its tooltip has it all). */
.lib-cell--when { width: 110px; }
/* An area from a newer game (task 08): greyed, with only its message at full strength. */
.lib-row--newer .lib-name { color: var(--muted); -unity-text-outline-color: var(--muted); -unity-font-style: normal; opacity: 0.6; }
.lib-row--newer .lib-cell { opacity: 0.6; }
.lib-row--newer .mp-go:disabled { opacity: 0.6; }   /* the mockup's disabled "go" (dis-bg, dis-fg), a little fainter */
/* The demo built into the game (task P2-03): Manage Areas names why it has no Rename or Delete. */
.lib-builtin { color: var(--muted); -unity-text-outline-color: var(--muted); font-size: 13px; padding: 6px 4px; -unity-text-align: middle-right; }

/* ---------- S4 download card and pill ---------- */
.download {
    position: absolute; left: 16px; bottom: 16px; width: 470px;   /* the pill takes its place when it's minimised */
}
.dl-stages { padding: 10px 16px 4px 16px; }
.dl-stage { flex-direction: row; align-items: center; min-height: 22px; }
.dl-tick { width: 20px; color: var(--soft); -unity-text-outline-color: var(--soft); -unity-font-style: bold; }
.dl-stage-name { color: var(--dim); -unity-text-outline-color: var(--dim); font-size: 13px; }
.dl-stage--done .dl-tick { color: var(--pos); -unity-text-outline-color: var(--pos); }
.dl-stage--done .dl-stage-name { color: var(--muted); -unity-text-outline-color: var(--muted); }
.dl-stage--current .dl-tick { color: var(--strong); -unity-text-outline-color: var(--strong); }
.dl-stage--current .dl-stage-name { color: var(--strong); -unity-text-outline-color: var(--strong); -unity-font-style: bold; }
.dl-bar { height: 8px; margin: 10px 16px 6px 16px; background-color: var(--knock); border-width: 1px; border-color: var(--hair); border-radius: 2px; }
.dl-bar-fill { height: 100%; width: 0; background-color: var(--go-hover); }
.dl-row { flex-direction: row; justify-content: space-between; padding: 0 16px; }
.dl-detail { padding: 6px 16px 2px 16px; color: var(--text); -unity-text-outline-color: var(--text); font-size: 13px; white-space: normal; }
.download > .mono.muted { padding: 0 16px 8px 16px; font-size: 12px; }

.pill {
    position: absolute; left: 24px; bottom: 24px;   /* bottom left: the title keeps bottom right for its plates */
    padding: 8px 14px; border-width: 1px; border-color: var(--hair); border-radius: 3px;
    background-color: var(--panel); color: var(--text); -unity-text-outline-color: var(--text); font-size: 14px; -unity-font-style: bold;
}
.pill:hover { background-color: var(--hover); }
/* Task P2-06: a hairline of progress under the line; its colour says the state (running, waiting, stopped). */
.pill { flex-direction: column; align-items: stretch; padding-bottom: 6px; }
.pill-text { padding: 0; margin: 0; color: var(--text); -unity-text-outline-color: var(--text); font-size: 14px; -unity-font-style: bold; }
.pill-bar { height: 2px; margin-top: 5px; background-color: var(--knock); }
.pill-fill { height: 2px; width: 0; background-color: var(--go-hover); }
.pill--waiting .pill-fill { background-color: var(--warn); }
.pill--paused .pill-fill { background-color: var(--soft); }
.pill--failed .pill-fill { background-color: var(--neg); }
.pill--failed .pill-text { color: var(--neg); -unity-text-outline-color: var(--neg); }

/* ---------- S5 quality card ---------- */
.quality-panel { width: 520px; }
.qc-line { padding: 10px 0; border-bottom-width: 1px; border-bottom-color: var(--row); }
.qc-head { flex-direction: row; align-items: center; }
.qc-label { width: 90px; font-size: 15px; -unity-font-style: bold; color: var(--head); -unity-text-outline-color: var(--head); }
.qc-score { width: 116px; font-size: 18px; -unity-font-style: bold; color: var(--strong); -unity-text-outline-color: var(--strong); }
.qc-word { font-size: 15px; -unity-font-style: bold; }
.qc-word--excellent, .qc-word--good { color: var(--pos); -unity-text-outline-color: var(--pos); }
.qc-word--fair { color: var(--warn); -unity-text-outline-color: var(--warn); }
.qc-word--limited { color: var(--neg); -unity-text-outline-color: var(--neg); }
.qc-caveat { color: var(--warn); -unity-text-outline-color: var(--warn); font-size: 13px; margin-top: 4px; white-space: normal; }
.qc-detail { color: var(--muted); -unity-text-outline-color: var(--muted); font-size: 13px; margin-top: 4px; white-space: normal; }

/* ---------- S8 settings and S9 credits ---------- */
.settings-win { width: 780px; height: 500px; max-height: 96%; }
.settings-body { flex-direction: row; flex-grow: 1; flex-shrink: 1; min-height: 0; }
.settings-page { flex-grow: 1; padding: 4px 20px 14px 20px; }
/* the page's scrollbar: a thin hairline thumb as a browser draws the mockup's, no arrow buttons (task P2-05) */
.settings-page .unity-scroller--vertical { width: 8px; margin: 6px 0 6px 6px; border-width: 0; background-color: rgba(0, 0, 0, 0); }
.settings-page .unity-scroller--vertical .unity-scroller__low-button,
.settings-page .unity-scroller--vertical .unity-scroller__high-button { display: none; }
.settings-page .unity-scroller--vertical .unity-scroller__slider { margin: 0; padding: 0; }
.settings-page .unity-scroller--vertical .unity-base-slider__drag-container { width: 8px; }
.settings-page .unity-scroller--vertical .unity-base-slider__tracker { left: 0; width: 8px; border-width: 0; background-color: rgba(0, 0, 0, 0); }
.settings-page .unity-scroller--vertical .unity-base-slider__dragger { left: 1px; width: 6px; border-width: 0; border-radius: 3px; background-color: var(--hair2); }
.settings-page .unity-scroller--vertical .unity-base-slider__dragger:hover { background-color: var(--faint); }
.settings-page .unity-scroller--vertical .unity-base-slider__dragger-border { display: none; }
.settings-done { min-width: 120px; }
/* Task P2-05: the rows the mockup's SETTINGS table draws, in USS. */
.mp-pnote { margin: -4px 0 8px 0; padding: 0; font-size: 12px; color: var(--soft); -unity-text-outline-color: var(--soft); white-space: normal; }
.mp-srow > .mp-range, .mp-srow > .settings-action, .mp-srow > .settings-pair { width: 236px; flex-shrink: 0; }
.settings-pair { flex-direction: row; }
.settings-pair > .settings-action { flex-grow: 1; flex-basis: 0; margin: 0; }
.settings-pair > .settings-pair__first { margin-right: 8px; }
.settings-action { height: 30px; margin: 0; }
.settings-action:disabled { background-color: rgba(0, 0, 0, 0); border-color: var(--hair); color: var(--faint); -unity-text-outline-color: var(--faint); opacity: 1; }
.settings-path { -unity-font-definition: url("/Assets/MountainPlanner/Art/UI/Fonts/OverpassMono-SDF.asset"); font-size: 11.5px; }
/* a slider: a thin track filled to the value, a square thumb, and the value (.rng-wrap) */
.mp-range { flex-direction: row; align-items: center; }
.mp-range__slider { flex-grow: 1; margin: 0 12px 0 0; padding: 0; }
.mp-range__slider .unity-base-slider__drag-container { height: 20px; }
.mp-range__slider .unity-base-slider__tracker { height: 4px; margin-top: -2px; border-width: 0; border-radius: 2px; background-color: var(--hair2); }
.mp-range__slider .unity-base-slider__fill { height: 4px; margin-top: -2px; border-radius: 2px; background-color: var(--text); }
.mp-range__slider .unity-base-slider__dragger { width: 12px; height: 18px; margin-top: -9px; margin-left: -6px; border-width: 1px; border-color: var(--hair2); border-radius: 3px; background-color: var(--on-bg); }
.mp-range__slider .unity-base-slider__dragger-border { display: none; }
.mp-range__v { width: 48px; margin: 0; padding: 0; -unity-text-align: middle-right; font-size: 12.5px; color: var(--text); -unity-text-outline-color: var(--text); }
/* Display: keep the new settings, or they go back after 15 s */
.settings-keep { flex-direction: row; align-items: center; margin: 0 0 10px 0; padding: 10px 12px; border-width: 1px; border-color: var(--warn); border-radius: 4px; background-color: var(--tile); }
.settings-keep__text { flex-grow: 1; flex-shrink: 1; }
.settings-keep__title { margin: 0; padding: 0; font-size: 13px; -unity-font-style: bold; color: var(--text); -unity-text-outline-color: var(--text); }
.settings-keep__count { margin: 2px 0 0 0; padding: 0; font-size: 12px; color: var(--soft); -unity-text-outline-color: var(--soft); }
.settings-keep > .mp-ghost { margin: 0 8px 0 12px; }
.settings-keep__ok { min-width: 90px; }
/* Controls: the keys, two per action, as key caps (.kbd) */
.settings-keys-head { flex-direction: row; align-items: center; padding-top: 10px; }
.settings-keys-head > .mp-ghost { height: 28px; margin: 0; }
.settings-group { margin: 10px 0 2px 0; padding: 0; font-size: 12px; -unity-font-style: bold; color: var(--muted); -unity-text-outline-color: var(--muted); }
.settings-key { flex-direction: row; align-items: center; padding: 4px 0; border-top-width: 1px; border-top-color: var(--row); }
.settings-key__label { flex-grow: 1; flex-shrink: 1; margin: 0; padding: 0; font-size: 12.5px; -unity-font-style: bold; color: var(--muted); -unity-text-outline-color: var(--muted); }
.settings-kbd {
    width: 110px;
    height: 24px;
    margin: 0 0 0 8px;
    padding: 0 6px;
    border-width: 1px 1px 2px 1px;
    border-color: var(--hair2);
    border-radius: 4px;
    background-color: var(--tile);
    color: var(--text);
    -unity-text-outline-color: var(--text);
    -unity-font-definition: url("/Assets/MountainPlanner/Art/UI/Fonts/OverpassMono-SDF.asset");
    font-size: 11.5px;
    -unity-text-align: middle-center;
}
.settings-kbd:hover { background-color: var(--tile-hover); color: var(--strong); -unity-text-outline-color: var(--strong); }
.settings-kbd:disabled { opacity: 1; color: var(--faint); -unity-text-outline-color: var(--faint); }
.settings-kbd--empty { color: var(--faint); -unity-text-outline-color: var(--faint); }
.settings-kbd--listening, .settings-kbd--listening:hover { background-color: var(--on-bg); border-color: var(--on-bg); color: var(--on-fg); -unity-text-outline-color: var(--on-fg); }
.settings-kbd-gap { width: 118px; flex-shrink: 0; }
/* S9 credits (task P2-07; mockup .pn.cred): a window like Settings; sources in rows with the licence on the right */
.credits-panel { width: 660px; height: 540px; max-height: 96%; }
.credits-body { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.credits-body .unity-scroller--vertical { width: 8px; }
.credits-body .unity-scroller--vertical .unity-scroller__low-button, .credits-body .unity-scroller--vertical .unity-scroller__high-button { display: none; }
.credits-body .unity-scroller--vertical .unity-scroller__slider { margin: 0; padding: 0; }
.credits-body .unity-scroller--vertical .unity-base-slider__drag-container { width: 8px; }
.credits-body .unity-scroller--vertical .unity-base-slider__tracker { left: 0; width: 8px; border-width: 0; background-color: rgba(0, 0, 0, 0); }
.credits-body .unity-scroller--vertical .unity-base-slider__dragger { left: 1px; width: 6px; border-width: 0; border-radius: 3px; background-color: var(--hair2); }
.credits-body .unity-scroller--vertical .unity-base-slider__dragger-border { display: none; }
.credits-hero { padding: 16px 16px 12px 16px; border-bottom-width: 1px; border-bottom-color: var(--hair); }
.credits-game { font-size: 19px; -unity-font-style: bold; color: var(--strong); -unity-text-outline-color: var(--strong); margin: 0; padding: 0; }
.credits-by { flex-direction: row; flex-wrap: wrap; margin-top: 3px; }
.credits-by-text { font-size: 13px; color: var(--muted); -unity-text-outline-color: var(--muted); margin: 0; padding: 0; }
.credits-studio { font-size: 13px; -unity-font-style: bold; color: var(--text); -unity-text-outline-color: var(--text); margin: 0 4px; padding: 0; }
.credits-sub { flex-direction: row; justify-content: space-between; padding: 14px 16px 4px 16px; }
.credits-sub-title { font-size: 12.5px; -unity-font-style: bold; color: var(--head); -unity-text-outline-color: var(--head); margin: 0; padding: 0; }
.credits-sub-note { font-size: 12.5px; color: var(--soft); -unity-text-outline-color: var(--soft); margin: 0; padding: 0; }
.credits-src { padding: 7px 16px; border-top-width: 1px; border-top-color: var(--row); }
.credits-src--first { border-top-width: 0; }
.credits-src-top { flex-direction: row; align-items: flex-start; }
.credits-who { flex-grow: 1; flex-shrink: 1; font-size: 12.5px; color: var(--text); -unity-text-outline-color: var(--text); white-space: normal; margin: 0; padding: 0; }
.credits-lic { flex-shrink: 0; margin: 0 0 0 16px; padding: 0; font-size: 11.5px; color: var(--soft); -unity-text-outline-color: var(--soft); -unity-text-align: upper-right; }
.credits-detail { font-size: 11.5px; color: var(--soft); -unity-text-outline-color: var(--soft); white-space: normal; margin: 2px 0 0 0; padding: 0; }
.credits-names { padding: 2px 16px 0 16px; font-size: 12.5px; color: var(--muted); -unity-text-outline-color: var(--muted); white-space: normal; margin: 0; }
.credits-empty { padding: 4px 16px 0 16px; font-size: 12.5px; color: var(--muted); -unity-text-outline-color: var(--muted); white-space: normal; margin: 0; }
.credits-ofl { padding: 12px 16px; font-size: 11.5px; color: var(--muted); -unity-text-outline-color: var(--muted); white-space: normal; margin: 0; }
.credits-foot { justify-content: flex-start; }
.credits-note { flex-grow: 1; flex-shrink: 1; font-size: 12px; color: var(--soft); -unity-text-outline-color: var(--soft); white-space: normal; margin: 0 8px 0 0; padding: 0; }
.credits-licences { margin-right: 8px; }
.credits-done { min-width: 96px; }

/* ---------- S11 confirm and toast ---------- */
.confirm-panel { width: 420px; }
.confirm-text { white-space: normal; font-size: 15px; color: var(--text); -unity-text-outline-color: var(--text); }
/* Error and offline (task P2-06): what happened as the heading, then what to do. */
.confirm-title { white-space: normal; font-size: 16px; -unity-font-style: bold; margin-bottom: 6px; color: var(--strong); -unity-text-outline-color: var(--strong); }
.confirm-panel--error .confirm-title { color: var(--neg); -unity-text-outline-color: var(--neg); }
.confirm-panel--wide { width: 480px; }
/* The mockup's Rename dialog (task P2-04): head, field, hint, then a wide go button beside Cancel. */
.prompt-panel { width: 320px; }
.prompt-field { margin: 12px 12px 2px 12px; }
.prompt-field > .unity-base-text-field__input,
.prompt-field > .unity-text-field__input {
    height: 38px;
    padding: 0 11px;
    background-color: var(--field);
    border-width: 1px;
    border-color: var(--hair2);
    border-radius: 4px;
    color: var(--strong);
    -unity-text-outline-color: var(--strong);
    font-size: 15px;
    -unity-font-style: bold;
}
.prompt-field:focus > .unity-base-text-field__input,
.prompt-field:focus > .unity-text-field__input { border-color: var(--muted); }
.prompt-hint { padding: 7px 12px; margin: 0; font-size: 12.5px; white-space: normal; color: var(--muted); -unity-text-outline-color: var(--muted); }
.prompt-acts { flex-direction: row; padding: 4px 12px 12px 12px; }
.prompt-acts > .prompt-go { flex-grow: 1; margin-right: 6px; }

.toast {
    position: absolute; left: 50%; bottom: 120px; translate: -50% 0;
    padding: 8px 14px; background-color: var(--panel); border-width: 1px; border-color: var(--hair); border-radius: 3px;
}

/* ---------- Task P2-03: the cover while a mountain opens ----------
   Brand, not theme: the same warm near-black and sign white in Dark and Light. The name plate is the title's own;
   a two-pixel rule fills as the mountain opens; the studio sits at the foot in plain Overpass. */
.cover {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-color: #1f1c19;
    align-items: center; justify-content: center;
    opacity: 1; transition-property: opacity; transition-duration: 0.7s; transition-timing-function: ease-in-out;
}
.cover--fading { opacity: 0; }
.cover-mark { width: 340px; align-items: stretch; }
.cover-plate { margin-bottom: 22px; }
.cover-rule { height: 2px; background-color: rgba(251, 248, 242, 0.16); }
.cover-fill { height: 2px; width: 0; background-color: #fbf8f2; }
.cover-text {
    margin: 12px 0 0 0; padding: 0; font-size: 13px; -unity-text-align: middle-center;
    color: rgba(251, 248, 242, 0.72); -unity-text-outline-color: rgba(251, 248, 242, 0.72);
}
.cover-studio {
    position: absolute; bottom: 36px; left: 0; right: 0; padding: 0; margin: 0;
    font-size: 15px; -unity-font-style: bold; -unity-text-align: middle-center;
    color: rgba(251, 248, 242, 0.6); -unity-text-outline-color: rgba(251, 248, 242, 0.6);
}
