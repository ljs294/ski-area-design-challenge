/* Task P3-14: Send feedback, the error notice's Send logs and the title's offer after a crash (the accepted mockup's
   #demo=fb, fbsug, fbcrash, fbsent, errnote and crashoffer). Solid plates in the theme's tokens; every colour sets its
   text outline too (UiThemeTests). This file is P3-14's; Flow.uss stays as it was. */

.feedback-panel { width: 560px; }
.feedback-form { padding-bottom: 12px; flex-shrink: 1; min-height: 0; }
.feedback-body { flex-shrink: 1; min-height: 0; }
.feedback-kind { margin: 12px 12px 0 12px; }
.feedback-kind > .mp-seg__opt { flex-grow: 1; height: 30px; font-size: 12.5px; }
.feedback-cap {
    margin: 0; padding: 10px 12px 4px 12px; font-size: 12px; -unity-font-style: bold;
    color: var(--muted); -unity-text-outline-color: var(--muted);
}
.feedback-field { margin: 0 12px; }
.feedback-field > .unity-base-text-field__input,
.feedback-field > .unity-text-field__input {
    height: 34px; padding: 0 11px;
    background-color: var(--field); border-width: 1px; border-color: var(--hair2); border-radius: 4px;
    color: var(--strong); -unity-text-outline-color: var(--strong); font-size: 13.5px; -unity-font-style: bold;
}
.feedback-note > .unity-base-text-field__input,
.feedback-note > .unity-text-field__input {
    height: 84px; padding: 8px 11px; -unity-text-align: upper-left; white-space: normal;
    font-size: 13px; -unity-font-style: normal;
}
.feedback-field:focus > .unity-base-text-field__input,
.feedback-field:focus > .unity-text-field__input { border-color: var(--muted); }

.feedback-parts { margin: 0 12px; border-width: 1px; border-color: var(--hair); border-radius: 4px; }
.feedback-part {
    flex-direction: row; align-items: center; min-height: 32px; padding: 4px 10px;
    border-top-width: 1px; border-color: var(--div);
}
.feedback-part--first { border-top-width: 0; }
.feedback-part:hover { background-color: var(--hover); }
.feedback-part:focus { background-color: var(--row); }
.feedback-part__chk {
    width: 15px; height: 15px; flex-shrink: 0; margin-right: 10px; align-items: center; justify-content: center;
    border-width: 1.5px; border-color: var(--dim); border-radius: 3px;
}
.feedback-part__tick {
    width: 7px; height: 4px; border-left-width: 2px; border-bottom-width: 2px; border-color: var(--on-fg);
    rotate: -45deg; translate: 0.5px -1px; display: none;
}
.feedback-part--on .feedback-part__chk { background-color: var(--on-bg); border-color: var(--on-bg); }
.feedback-part--on .feedback-part__tick { display: flex; }
.feedback-part__text { flex-grow: 1; flex-shrink: 1; }
.feedback-part__name { margin: 0; padding: 0; font-size: 12.5px; -unity-font-style: bold; color: var(--text); -unity-text-outline-color: var(--text); }
.feedback-part__sub { margin: 0; padding: 0; font-size: 11.5px; white-space: normal; color: var(--soft); -unity-text-outline-color: var(--soft); }
.feedback-part--off .feedback-part__name { color: var(--soft); -unity-text-outline-color: var(--soft); }
.feedback-part__size { margin: 0 0 0 10px; padding: 0; font-size: 11.5px; color: var(--muted); -unity-text-outline-color: var(--muted); }

.feedback-total { flex-direction: row; justify-content: space-between; padding: 6px 12px 0 12px; }
.feedback-total > Label { margin: 0; padding: 0; font-size: 11.5px; color: var(--soft); -unity-text-outline-color: var(--soft); }
.feedback-total--over > .feedback-total__r { color: var(--neg); -unity-text-outline-color: var(--neg); }
.feedback-privacy {
    margin: 10px 12px 0 12px; padding: 8px 10px; white-space: normal; font-size: 12px;
    border-left-width: 3px; border-color: var(--hair2); background-color: var(--tile);
    color: var(--muted); -unity-text-outline-color: var(--muted);
}
.feedback-acts { flex-direction: row; padding: 12px 12px 0 12px; }
.feedback-acts > .feedback-go { flex-grow: 1; }
.feedback-acts > .mp-ghost { margin-left: 6px; }

.feedback-file {
    flex-direction: row; align-items: center; margin: 12px 12px 0 12px; padding: 10px 12px;
    border-width: 1px; border-color: var(--hair); border-radius: 4px; background-color: var(--tile);
}
.feedback-file__name { flex-grow: 1; margin: 0; padding: 0; font-size: 13px; -unity-font-style: bold; color: var(--strong); -unity-text-outline-color: var(--strong); }
.feedback-file__size { margin: 0; padding: 0; font-size: 11.5px; color: var(--soft); -unity-text-outline-color: var(--soft); }
.feedback-step { margin: 0; padding: 8px 12px 0 12px; white-space: normal; font-size: 12.5px; color: var(--text); -unity-text-outline-color: var(--text); }
.feedback-hint { margin: 0; padding: 8px 12px 0 12px; white-space: normal; font-size: 12.5px; color: var(--muted); -unity-text-outline-color: var(--muted); }

/* The error notice's Send logs (P2-10's notice) and the title's offer after a crash share the notice plate. */
.error-notice > .mp-go { height: 28px; margin-right: 4px; }
