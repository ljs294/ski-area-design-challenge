/* S3 Site picker in the accepted Trailhead look (game-ui-direction.md UI-6 and §5): a solid instrument panel
   with hairline rules, warm graphite in dark mode and sign white in light mode. Tokens and component sizes
   follow the accepted mockup (prototypes/ui-layout.html): its modal window head, field, segmented switch,
   slider, legend swatch, figure, key cap, ghost button and the one filled commit button ("go").
   Surveyor's orange is for the planned square only (it is drawn by TileMapView), never for focus or state.
   Focus shows as a light hairline ring, like the mockup's focused field. The UI thread may move the tokens
   into the shared themes later.
   Panels are solid here: the mockup's 96% panel is near-solid in a browser, but Unity blends UI in linear
   space, where 96% over the bright map lets about 13% of it show through. */

.picker {
    --panel: rgb(28, 25, 22);
    --hair: #3b3632;
    --hair2: #4a443e;
    --div: #3d3833;
    --row: #36312c;
    --text: #efe9df;
    --strong: #ffffff;
    --head: #e6dfd4;
    --muted: #cfc7bb;
    --soft: #a39b90;
    --dim: #8f877c;
    --faint: #5d5750;
    --hover: #34302b;
    --chip: #3b3631;
    --tile: #2d2926;
    --on-bg: #efe9df;
    --on-fg: #1b1815;
    --field: #12100e;
    --warn: #f0b43c;
    --go: #1a6b3c;
    --go-hover: #1f7d47;
    --dis-bg: #2e2a26;
    --dis-fg: #6f675e;
    --ghost-hover: #8f877c;
    --scrim: rgba(10, 16, 26, 0.45);

    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--scrim);
    color: var(--text);
    font-size: 13px;
    transition-property: opacity;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

/* Light: sign white and near-black (the mockup's light set), not cream. */
.picker--light {
    --panel: rgb(250, 248, 244);
    --hair: #ddd7cd;
    --hair2: #cbc4b9;
    --div: #e2dcd2;
    --row: #ebe6de;
    --text: #1f1c19;
    --strong: #0f0d0b;
    --head: #2b2724;
    --muted: #4a443e;
    --soft: #6b645b;
    --dim: #8a8278;
    --faint: #b8b0a5;
    --hover: #ede8e0;
    --chip: #e7e1d7;
    --tile: #f0ebe3;
    --on-bg: #1f1c19;
    --on-fg: #faf8f4;
    --field: #ffffff;
    --warn: #a5650c;
    --dis-bg: #ebe6de;
    --dis-fg: #a39b90;
    --ghost-hover: #8a8278;
    --scrim: rgba(20, 30, 45, 0.30);
}

.grow { flex-grow: 1; }
.hidden { display: none; }
/* Figures carry the class "mono": Overpass Mono (tabular numbers) once the fonts land. */

.picker-window {
    width: 1040px;
    max-width: 96%;
    max-height: 96%;
    background-color: var(--panel);
    border-width: 1px;
    border-color: var(--hair);
    border-radius: 6px;
}

/* The mockup's panel head: 38 px, the title in heavy type, a square ✕ on the right. */
.picker-head {
    flex-direction: row;
    align-items: center;
    height: 38px;
    padding: 0 8px 0 12px;
    border-bottom-width: 1px;
    border-bottom-color: var(--hair);
}
.picker-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--strong);
}
.picker-close {
    width: 26px;
    height: 26px;
    margin: 0;
    padding: 0;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--soft);
    font-size: 12px;
}
.picker-close:hover { background-color: var(--hover); color: var(--strong); }
.picker-close:focus { border-color: var(--muted); color: var(--strong); }

/* Rows: a key on the left at one width, so the fields line up like an instrument panel. */
.picker-row {
    flex-direction: row;
    align-items: center;
    min-height: 46px;
    padding: 0 12px;
    border-top-width: 1px;
    border-top-color: var(--row);
}
.picker-search { border-top-width: 0; padding-top: 6px; padding-bottom: 6px; }
.picker-key {
    width: 60px;
    color: var(--muted);
    -unity-font-style: bold;
    font-size: 13px;
}
.picker-hint {
    margin-left: 6px;
    color: var(--dim);
    font-size: 12.5px;
}
.picker-hint--fixed { width: 64px; margin-left: 10px; }
.picker-end {
    color: var(--soft);
    font-size: 12.5px;
    margin: 0 8px;
}
.picker-figure {
    width: 74px;
    -unity-text-align: middle-right;
    color: var(--strong);
    font-size: 15px;
    -unity-font-style: bold;
}

/* A key cap, as in the mockup's Controls page. */
.kbd {
    min-width: 22px;
    height: 22px;
    margin-left: 10px;
    padding: 0 6px;
    border-width: 1px;
    border-bottom-width: 2px;
    border-color: var(--hair2);
    border-radius: 4px;
    background-color: var(--tile);
    color: var(--text);
    font-size: 11.5px;
    -unity-text-align: middle-center;
}

/* Fields: the mockup's field, a dark well (white in light mode) with a hairline, bold type. */
.picker-field { margin: 0; }
.picker-field > .unity-base-text-field__input,
.picker-field > .unity-text-field__input {
    height: 38px;
    padding: 0 11px;
    background-color: var(--field);
    border-width: 1px;
    border-color: var(--hair2);
    border-radius: 4px;
    color: var(--strong);
    font-size: 15px;
    -unity-font-style: bold;
    --unity-cursor-color: #ffffff;
    --unity-selection-color: rgba(207, 199, 187, 0.35);
}
.picker--light .picker-field > .unity-base-text-field__input,
.picker--light .picker-field > .unity-text-field__input {
    --unity-cursor-color: #0f0d0b;
    --unity-selection-color: rgba(74, 68, 62, 0.25);
}
.picker-field:focus > .unity-base-text-field__input,
.picker-field:focus > .unity-text-field__input { border-color: var(--muted); }
.picker-field .unity-base-text-field__input--placeholder { color: var(--dim); -unity-font-style: normal; }

/* Search results: the mockup's drop-down rows, floating over the map under the search field. */
.picker-results {
    position: absolute;
    top: 86px;
    left: 72px;
    right: 12px;
    background-color: var(--panel);
    border-width: 1px;
    border-color: var(--hair);
    border-radius: 6px;
    padding: 4px 0;
}
.picker-results__message {
    padding: 8px 12px;
    color: var(--soft);
    font-size: 12.5px;
    white-space: normal;
}
.result {
    flex-direction: column;
    align-items: flex-start;
    margin: 0;
    padding: 6px 12px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
}
.result:hover { background-color: var(--hover); }
.result:focus { background-color: var(--hover); border-color: var(--muted); }
.result__name { color: var(--strong); -unity-font-style: bold; font-size: 13px; }
.result__where { color: var(--soft); font-size: 12px; margin-top: 1px; }

/* The map: edge to edge between hairlines, its few controls on small solid plates. */
.map-frame {
    height: 540px;
    border-top-width: 1px;
    border-top-color: var(--hair);
    background-color: #d9d4c8;
}
.map-host { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.tile-map {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
}
.tile-map:focus { border-color: var(--muted); }

/* The plan's dimension label (mockup: graphite plate, warm white figures), rotated along the square's top edge. */
.tile-map__dim {
    padding: 1px 6px;
    background-color: #1c1916;
    border-radius: 2px;
    color: #efe9df;
    font-size: 12px;
    -unity-font-style: bold;
    translate: -50% -50%;
}

.map-bar {
    position: absolute;
    left: 10px; right: 10px;
    flex-direction: row;
    align-items: flex-end;
}
.map-bar--top { top: 10px; align-items: flex-start; }
.map-bar--bottom { bottom: 10px; }

/* The top-centre strip, as in the mockup's sketching hint. */
.map-strip {
    position: absolute;
    left: 0; right: 0; top: 10px;
    align-items: center;
}
.strip {
    padding: 6px 12px;
    background-color: var(--panel);
    border-width: 1px;
    border-color: var(--hair);
    border-radius: 6px;
    color: var(--text);
    font-size: 13px;
}

/* The mockup's segmented switch: a hairline frame, dividers, the chosen one a white (in light: black) segment. */
.seg {
    flex-direction: row;
    background-color: var(--panel);
    border-width: 1px;
    border-color: var(--hair2);
    border-radius: 4px;
    overflow: hidden;
}
.seg__item {
    margin: 0;
    height: 28px;
    padding: 0 12px;
    border-width: 0;
    border-left-width: 1px;
    border-color: var(--hair2);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--soft);
    font-size: 12.5px;
    -unity-font-style: bold;
}
.seg__item--first { border-left-width: 0; }
.seg__item:hover { color: var(--strong); }
.seg__item--on, .seg__item--on:hover { background-color: var(--on-bg); color: var(--on-fg); }
.seg__item:focus { border-color: var(--muted); border-width: 1px; }

/* The legend: a plate with the switch and swatches paired with words (colour is never the only signal). */
.legend {
    flex-direction: row;
    align-items: center;
    background-color: var(--panel);
    border-width: 1px;
    border-color: var(--hair);
    border-radius: 6px;
    padding: 3px;
}
.legend-items { flex-direction: row; align-items: center; padding: 0 8px 0 4px; }
.legend-toggle {
    margin: 0;
    height: 26px;
    padding: 0 10px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--text);
    font-size: 12.5px;
    -unity-font-style: bold;
}
.legend-toggle:hover { background-color: var(--hover); }
.legend-toggle--on, .legend-toggle--on:hover { background-color: var(--on-bg); color: var(--on-fg); }
.legend-toggle:focus { border-color: var(--muted); }
/* The mockup's legend swatch: 22 × 12 with a faint dark edge. Overlay colours don't change with the theme. */
.swatch {
    width: 22px; height: 12px;
    margin: 0 6px 0 10px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.25);
    border-radius: 2px;
}
.swatch--s1m { background-color: #1d4f91; }
.swatch--lidar { background-color: #3f86d0; }
.swatch--three { background-color: #9fc4ee; }
.swatch--ten { border-color: var(--soft); }
.legend-label { color: var(--muted); font-size: 12.5px; }
.legend--off .legend-items { display: none; }

.attribution {
    padding: 2px 6px;
    background-color: var(--panel);
    border-radius: 3px;
    color: var(--soft);
    font-size: 11px;
}

/* Offline: the map area turns into a plain panel with Retry (0.4 §3). Retry is a ghost: the window has one commit. */
.offline {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--panel);
    padding: 0 25%;
}
.offline-title { font-size: 15px; -unity-font-style: bold; color: var(--strong); margin-bottom: 8px; }
.offline-text { color: var(--muted); font-size: 13px; white-space: normal; -unity-text-align: upper-center; margin-bottom: 16px; }

/* The mockup's slider: a thin track filled to the value, a small square thumb. */
.picker-slider {
    margin: 0;
    padding: 0 6px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 4px;
}
.picker-slider:focus { border-color: var(--muted); }
.picker-slider .unity-base-slider__tracker {
    height: 4px;
    margin-top: -2px;
    border-width: 0;
    border-radius: 2px;
    background-color: var(--hair2);
}
.picker-slider .picker-slider__fill {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    border-radius: 2px;
    background-color: var(--text);
}
.picker-slider .unity-base-slider__dragger {
    width: 12px; height: 18px;
    margin-top: -9px;
    border-width: 1px;
    border-color: var(--hair2);
    border-radius: 3px;
    background-color: var(--on-bg);
}
.picker-slider .unity-base-slider__dragger-border { display: none; }

/* The estimate: figures with a small label above, divided by hairlines (the mockup's two-column figures). */
.estimate { min-height: 56px; }
.estimate__empty { color: var(--soft); font-size: 12.5px; padding-left: 60px; }
.estimate__figs { flex-direction: row; align-items: stretch; flex-grow: 1; padding-left: 60px; }
.fig { padding: 2px 16px 2px 0; justify-content: center; }
.fig--sep { padding-left: 16px; border-left-width: 1px; border-left-color: var(--hair); }
.fig__lab { color: var(--soft); font-size: 11.5px; -unity-font-style: bold; margin-bottom: 2px; }
.fig__row { flex-direction: row; align-items: flex-end; }
.fig__val { color: var(--strong); font-size: 15px; -unity-font-style: bold; }
.fig__word { color: var(--text); font-size: 12.5px; -unity-font-style: bold; margin-left: 6px; margin-bottom: 1px; }
.fig__text { color: var(--text); font-size: 13px; white-space: normal; }
.fig--rough .fig__val, .fig--rough .fig__word { color: var(--warn); }
/* Warnings are amber and in words (game-ui-direction §5). */
.estimate__warning {
    padding: 0 12px 10px 72px;
    color: var(--warn);
    font-size: 12.5px;
    white-space: normal;
}

.picker-foot { min-height: 58px; }
.picker-note { color: var(--soft); font-size: 12.5px; white-space: normal; padding-right: 12px; }

/* Ghost buttons (Cancel, Retry): a hairline frame, no fill. */
.ghost {
    height: 36px;
    margin: 0 0 0 8px;
    padding: 0 14px;
    border-width: 1px;
    border-color: var(--hair2);
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--muted);
    font-size: 12.5px;
    -unity-font-style: bold;
}
.ghost:hover { border-color: var(--ghost-hover); color: var(--strong); }
.ghost:focus { border-color: var(--muted); color: var(--strong); }

/* The one filled button per window: the commit, with its figure (the mockup's "Break ground   $3.2M"). */
.go {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-width: 170px;
    height: 36px;
    margin: 0 0 0 8px;
    padding: 0 12px;
    border-width: 1px;
    border-color: var(--go);
    border-radius: 4px;
    background-color: var(--go);
}
.go:hover { background-color: var(--go-hover); border-color: var(--go-hover); }
.go:focus { border-color: var(--strong); }
.go__label { color: #ffffff; font-size: 13px; -unity-font-style: bold; }
.go__fig { color: #ffffff; font-size: 12.5px; margin-left: 14px; }
.go:disabled { background-color: var(--dis-bg); border-color: var(--dis-bg); }
.go:disabled .go__label, .go:disabled .go__fig { color: var(--dis-fg); }
