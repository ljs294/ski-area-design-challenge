{
  "name": "ski-area-design-challenge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:lab": "node scripts/devLab.mjs",
    "sim:time": "tsx time-engine/src/cli.ts",
    "sim:weather": "tsx weather-engine/src/cli.ts",
    "sim:weather:refresh-jackson": "tsx weather-engine/src/refreshJacksonFixture.ts",
    "build": "npm run typecheck && npm run build:desktop",
    "build:desktop": "vite build",
    "build:web": "vite build --config vite.config.web.ts",
    "preview": "vite preview",
    "package": "tsc && vite build && electron-builder",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0 --report-unused-disable-directives",
    "check:agent-docs": "node scripts/checkAgentDocs.mjs",
    "check:architecture": "node scripts/checkArchitecture.mjs",
    "check:obsolete": "node scripts/checkObsoleteVertical.mjs",
    "check:bundle": "node scripts/checkBundleBudget.mjs",
    "metrics:refactor": "node scripts/refactorMetrics.mjs",
    "test": "npm run test:unit",
    "test:unit": "vitest run --exclude \"**/*.integration.test.ts\" --exclude \"tests/e2e/**\" --testTimeout 10000",
    "test:integration:live": "vitest run integration.test",
    "test:e2e:smoke": "npm run build:desktop && node scripts/runE2E.mjs --project=browser-smoke",
    "test:e2e:features": "npm run build:desktop && node scripts/runE2E.mjs --project=feature-workflows",
    "test:e2e": "npm run build:desktop && node scripts/runE2E.mjs --project=browser-smoke --project=feature-workflows",
    "check:e2e-harness": "node scripts/checkE2EHarness.mjs",
    "check": "npm run check:agent-docs && npm run check:architecture && npm run lint && npm run typecheck && npm run test:unit && npm run build:desktop && npm run build:web && npm run check:bundle && npm run check:obsolete"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "8.66.0",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "playwright": "^1.61.1",
    "tsx": "4.23.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-electron": "^1.1.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@loaders.gl/core": "^4.4.3",
    "@loaders.gl/las": "^4.4.3",
    "@math.gl/types": "^4.1.0",
    "geotiff": "^3.0.5",
    "maplibre-contour": "^0.1.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "build": {
    "appId": "com.lukesmall.mountainplanner",
    "productName": "Mountain Planner",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "portable"
    }
  }
}
